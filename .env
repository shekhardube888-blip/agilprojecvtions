DATABASE_URL=file:/home/z/my-project/db/custom.db
SESSION_SECRET="agileprojection-portal-dev-secret-change-in-production"

# ─── Google OAuth (for student login) ───
# Get these from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── NextAuth ───
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-nextauth-secret-change-me-in-production"

# ─── Admin credentials (NEVER displayed in UI; set in production!) ───
# The admin password is read from this env var and hashed before storage.
# In production, this MUST be set — otherwise admin login is disabled.
# In dev, this defaults to "admin123" if left unset (via auth.ts fallback).
ADMIN_EMAIL="admin@agileprojection.com"
ADMIN_PASSWORD="admin123"
