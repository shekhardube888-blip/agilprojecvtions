// ── SUPABASE / POSTGRES schema (for production deployment) ──
// Identical to schema.prisma (SQLite) but provider = "postgresql".
// Use this for Supabase + Vercel deployment.
//
// Local dev uses prisma/schema.prisma (SQLite). This file is for production:
//   bun run db:push:supabase   → create/migrate tables on Supabase Postgres
//   bun run db:generate:supabase → regenerate the Postgres Prisma client
//
// On Vercel, vercel.json runs: prisma generate --schema=prisma/schema.postgres.prisma && next build

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Student registration record (covers BE / B.Tech / ME / M.Tech / MCA / B.Sc Engg students)
model Student {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  mobile       String
  degree       String
  branch       String
  semester     String
  plan         String
  college      String
  state        String
  source       String?
  notes        String?
  category     String   // AI/ML domain key (gen-ai, cv, ml, nlp, etc.)
  categoryLabel String  // human-readable category label
  project      String   // selected project name
  projectId    Int?     // selected project id
  consentWa    Boolean  @default(true)
  consentEm    Boolean  @default(true)
  emailSent    Boolean  @default(false)
  waSent       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([category])
}

// Newsletter subscribers
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// AI assistant chat messages (for analytics / follow-up)
model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String   // 'user' | 'assistant'
  content   String
  degree    String?  // student degree context (BE / MCA / M.Tech ...)
  createdAt DateTime @default(now())

  @@index([sessionId])
}

// ── Login accounts ──
// Admin account (never expires, always unlocked) + guest accounts (guest1, guest2, …)
// whose access expires 2 days after the admin "unlocks" (payment received) them.
model Account {
  id            String   @id @default(cuid())
  username      String   @unique
  passwordHash  String                 // scrypt hash, salt-prefixed
  role          String   @default("guest") // "admin" | "guest"
  status        String   @default("locked") // "locked" | "unlocked"
  passwordSetAt DateTime?              // when the 2-day window started
  expiresAt     DateTime?              // passwordSetAt + 2 days
  fullName      String?
  note          String?                // e.g. "Payment received ₹X"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  unlockLogs    UnlockLog[]
}

// Audit trail of every admin "unlock / payment received" action.
model UnlockLog {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  adminUser String                  // who unlocked
  reason    String?                 // e.g. "Payment received"
  expiresAt DateTime               // the new expiry that was set
  createdAt DateTime @default(now())

  @@index([accountId])
}
