generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id               String        @id @default(cuid())
  firstName        String
  lastName         String
  email            String
  mobile           String
  degree           String
  branch           String
  subject          String        @default("")
  semester         String
  plan             String
  college          String
  state            String
  source           String?
  notes            String?
  category         String
  categoryLabel    String
  project          String
  projectId        Int?
  consentWa        Boolean       @default(true)
  consentEm        Boolean       @default(true)
  emailSent        Boolean       @default(false)
  waSent           Boolean       @default(false)
  paymentStatus    String        @default("pending")
  internshipStatus String        @default("not_started")
  currentStage     Int           @default(0)
  startedAt        DateTime?     @db.Timestamp(6)
  completedAt      DateTime?     @db.Timestamp(6)
  createdAt        DateTime      @default(now()) @db.Timestamp(6)
  updatedAt        DateTime      @updatedAt @db.Timestamp(6)
  Certificate      Certificate[]

  @@index([email])
  @@index([category])
  @@index([email, mobile])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now()) @db.Timestamp(6)
}

model Visitor {
  id        String   @id @default(cuid())
  uniqueId  String   @unique
  firstSeen DateTime @default(now()) @db.Timestamp(6)
  lastSeen  DateTime @default(now()) @db.Timestamp(6)
  views     Int      @default(1)

  @@index([lastSeen])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  degree    String?
  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@index([sessionId])
}

model Account {
  id            String      @id @default(cuid())
  username      String      @unique
  passwordHash  String
  role          String      @default("guest")
  status        String      @default("locked")
  passwordSetAt DateTime?   @db.Timestamp(6)
  expiresAt     DateTime?   @db.Timestamp(6)
  fullName      String?
  note          String?
  createdAt     DateTime    @default(now()) @db.Timestamp(6)
  updatedAt     DateTime    @updatedAt @db.Timestamp(6)
  unlockLogs    UnlockLog[]
}

// Audit trail of every admin "unlock / payment received" action.
model UnlockLog {
  id        String    @id @default(cuid())
  accountId String
  adminUser String
  action    String    @default("unlock")
  reason    String?
  expiresAt DateTime? @db.Timestamp(6)
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([createdAt])
}

model AssessmentAttempt {
  id           String   @id
  studentEmail String
  stage        Int
  score        Int
  passed       Boolean
  answers      String
  attemptedAt  DateTime @default(now()) @db.Timestamp(6)

  @@index([studentEmail])
  @@index([studentEmail, stage])
}

model Certificate {
  id                String   @id
  certificateNumber String   @unique
  studentId         String
  type              String   @default("Internship Completion")
  eligibility       String
  issuedAt          DateTime @default(now()) @db.Timestamp(6)
  createdAt         DateTime @default(now()) @db.Timestamp(6)
  Student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model College {
  id        String   @id
  name      String   @unique
  state     String?
  source    String   @default("seed")
  createdAt DateTime @default(now()) @db.Timestamp(6)

  @@index([name])
}

model DemoProjectRequest {
  id           String    @id
  studentEmail String
  studentName  String?
  subject      String
  project      String?
  requirements String
  status       String    @default("pending")
  mentorReply  String?
  reviewedBy   String?
  emailedAt    DateTime? @db.Timestamp(6)
  requestedAt  DateTime  @default(now()) @db.Timestamp(6)
  reviewedAt   DateTime? @db.Timestamp(6)

  @@index([status])
  @@index([studentEmail])
}

model LessonProgress {
  id           String   @id
  studentEmail String
  stage        Int
  lessonId     String
  completedAt  DateTime @default(now()) @db.Timestamp(6)

  @@unique([studentEmail, lessonId])
  @@index([studentEmail, stage])
}

model Submission {
  id             String    @id
  studentEmail   String
  studentName    String?
  stage          Int
  project        String?
  content        String
  status         String    @default("submitted")
  mentorFeedback String?
  reviewedBy     String?
  submittedAt    DateTime  @default(now()) @db.Timestamp(6)
  reviewedAt     DateTime? @db.Timestamp(6)

  @@unique([studentEmail, stage])
  @@index([status])
  @@index([studentEmail])
}

model TrainingModule {
  id            String   @id
  studentEmail  String
  stage         Int
  project       String
  categoryLabel String
  content       String
  aiAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @db.Timestamp(6)

  @@unique([studentEmail, stage])
  @@index([studentEmail])
}
