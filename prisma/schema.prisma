// ── AgileProjection · NT-AI Network — DEFAULT schema (SQLite) ──
// This is the default schema, used for local dev + the sandbox preview.
// DATABASE_URL should point at a local SQLite file, e.g. file:../db/custom.db
//
// For Supabase / Postgres deployment (Vercel + Supabase): use prisma/schema.postgres.prisma
//   - Local: bun run db:generate:pg && bun run db:push:pg  (with DATABASE_URL = your Supabase URL)
//   - Vercel: vercel.json runs `prisma generate --schema=prisma/schema.postgres.prisma && next build`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Student registration record (covers BE / B.Tech / ME / M.Tech / MCA / B.Sc Engg students)
model Student {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  mobile      String
  degree      String
  branch      String
  subject     String   @default("")  // field of interest: ai-ml, cs, mba, bba, etc.
  semester    String
  plan        String
  college     String
  state       String
  source      String?
  notes       String?
  category    String   // AI/ML domain key (gen-ai, cv, ml, nlp, etc.)
  categoryLabel String // human-readable category label
  project     String   // selected project name
  projectId   Int?     // selected project id
  consentWa   Boolean  @default(true)
  consentEm   Boolean  @default(true)
  emailSent   Boolean  @default(false)
  waSent      Boolean  @default(false)
  // ── Internship lifecycle (admin-controlled) ──
  paymentStatus    String   @default("pending")     // pending | confirmed
  internshipStatus String   @default("not_started")  // not_started | in_progress | completed
  currentStage     Int      @default(0)              // 0 = not started, 1-6 = stage in progress, 7 = all done
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  certificates Certificate[]

  @@index([email])
  @@index([category])
  @@index([email, mobile])
}

// Newsletter subscribers
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// ── Visitor analytics (page views + unique visitors) ──
model Visitor {
  id        String   @id @default(cuid())
  uniqueId  String   @unique              // cookie-based stable ID
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())
  views     Int      @default(1)          // page-view count from this visitor

  @@index([lastSeen])
}

// AI assistant chat messages (for analytics / follow-up)
model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String   // 'user' | 'assistant'
  content   String
  degree    String?  // student degree context (BE / MCA / M.Tech ...)
  createdAt DateTime @default(now())

  @@index([sessionId])
}

// Cached LLM-generated training modules — stored per student per stage so the
// LLM only generates ONCE. Subsequent visits return the cached version.
model TrainingModule {
  id             String   @id @default(cuid())
  studentEmail   String
  stage          Int
  project        String
  categoryLabel  String
  content        String
  aiAvailable    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentEmail, stage])
  @@index([studentEmail])
}

// Lesson progress tracking — which lessons has the student completed?
model LessonProgress {
  id           String   @id @default(cuid())
  studentEmail String
  stage        Int
  lessonId     String
  completedAt  DateTime @default(now())

  @@unique([studentEmail, lessonId])
  @@index([studentEmail, stage])
}

// Assignment submissions — student submits their work for each module's
// deliverable. Admin/mentor reviews → approve/reject + feedback.
// Certificate eligibility requires ALL submissions to be approved.
model Submission {
  id            String   @id @default(cuid())
  studentEmail  String
  studentName   String?
  stage         Int                       // which module (1-6)
  project       String?
  content       String                    // the submission (text, GitHub link, etc.)
  status        String   @default("submitted")  // submitted | approved | rejected
  mentorFeedback String?                 // admin's feedback on review
  reviewedBy    String?                  // admin username who reviewed
  submittedAt   DateTime @default(now())
  reviewedAt    DateTime?

  @@unique([studentEmail, stage])        // one submission per student per module
  @@index([studentEmail])
  @@index([status])
}

// ── Login accounts ──
// Admin account (never expires, always unlocked) + guest accounts (guest1, guest2, …)
// whose access expires 2 days after the admin "unlocks" (payment received) them.
model Account {
  id            String   @id @default(cuid())
  username      String   @unique
  passwordHash  String                 // scrypt hash, salt-prefixed
  role          String   @default("guest") // "admin" | "guest"
  status        String   @default("locked") // "locked" | "unlocked"
  passwordSetAt DateTime?              // when the 2-day window started
  expiresAt     DateTime?              // passwordSetAt + 2 days
  fullName      String?
  note          String?                // e.g. "Payment received ₹X"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  unlockLogs    UnlockLog[]
}

// Audit trail of every admin action on a user account.
// Actions: "unlock" | "lock" | "reset-password" | "set-expiry" | "renew"
model UnlockLog {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  adminUser String                  // who performed the action
  action    String   @default("unlock")  // unlock | lock | reset-password | set-expiry | renew
  reason    String?                 // e.g. "Student reported login issue"
  expiresAt DateTime?              // the new expiry set (null for lock/reset-password)
  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([createdAt])
}

// ── Auto-issued certificates (verifiable, with a unique certificate number) ──
model Certificate {
  id              String   @id @default(cuid())
  certificateNumber String @unique  // e.g. AP-2026-A1B2C3
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type            String   @default("Internship Completion")
  eligibility     String   // "attendance>75%, project completed, mentor approved"
  issuedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([studentId])
}

// ── Colleges (student-selectable + student-added) ──
model College {
  id        String   @id @default(cuid())
  name      String   @unique
  state     String?
  source    String   @default("seed")  // "seed" | "student-added"
  createdAt DateTime @default(now())
  @@index([name])
}
